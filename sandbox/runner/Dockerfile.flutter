ARG GHCR_OWNER
FROM ghcr.io/${GHCR_OWNER}/pothub-engine:latest
USER root
RUN apk add --no-cache curl unzip bash git xz zip && mkdir -p /opt/android-sdk/cmdline-tools
ENV ANDROID_HOME=/opt/android-sdk ANDROID_SDK_ROOT=/opt/android-sdk PATH=/opt/flutter/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/cmdline-tools/latest/bin:$PATH
RUN curl -fsSL https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -o /tmp/android-tools.zip \
  && unzip -q /tmp/android-tools.zip -d /opt/android-sdk/cmdline-tools \
  && mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest \
  && yes | sdkmanager --licenses >/dev/null \
  && sdkmanager 'platform-tools' 'platforms;android-35' 'build-tools;35.0.0' \
  && git clone --depth 1 --branch stable https://github.com/flutter/flutter.git /opt/flutter \
  && flutter precache --android \
  && rm -rf /tmp/android-tools.zip
WORKDIR /workspace

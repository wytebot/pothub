PORT=8787
# Public URL of the web app (CORS allows only this origin; 3-D Secure returns here)
APP_ORIGIN=https://your-app.example.com
LICENSE_SECRET=change-me-long-random
# Extra allowed origins, comma separated (the Android app origin https://localhost is already allowed)
EXTRA_ORIGINS=

# Firestore (billing records only; never media). Use ONE of:
#   FIREBASE_SERVICE_ACCOUNT = the service-account JSON on a single line, or
#   GOOGLE_APPLICATION_CREDENTIALS = path to the JSON file
FIREBASE_SERVICE_ACCOUNT=
# The same service account also verifies Google sign-in tokens for /api/account/* (project pothub-ca2a1).

# Flutterwave v4 (dashboard > Settings > API)
FLW_ENV=production
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
FLW_SECRET_HASH=
# Override only if Flutterwave's docs list a different host for your account
FLW_BASE_URL=

RATE_SOURCE_URL=https://open.er-api.com/v6/latest/USD
PRICE_ROUND_NGN=10
TRUST_PROXY=0

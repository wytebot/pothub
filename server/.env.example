PORT=8787
# Web app URL used for CORS. Android Capacitor origins are allowed automatically.
APP_ORIGIN=https://your-app.example.com
EXTRA_ORIGINS=
# Firebase service account is required to verify sign-in tokens. Firestore enables shared rate limiting; a local fallback is used if a rate-limit transaction fails.
FIREBASE_SERVICE_ACCOUNT=
# Or use GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Flutterwave hosted checkout billing (server-only secrets; never put these in VITE_ variables)
FLW_SECRET_KEY=FLWSECK_TEST-...
FLW_WEBHOOK_HASH=replace-with-random-long-webhook-secret
PRO_MONTHLY_AMOUNT=5.99
PRO_PLUS_MONTHLY_AMOUNT=9.99
PREMIUM_CURRENCY=USD

# GitHub OAuth for Codelab (secret stays on server)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://your-api.example.com/api/github/oauth/callback

# Publisher index: Firestore TTL is configured on the publisherSites collection using expiresAt.

# Repository analysis quota uses Firestore analysisQuota/{uid}: Free gets 10 analyses, then a five-hour cooldown. Paid plans are unlimited.
# Enable Firestore TTL on the analysisQuota collection group's expiresAt field after deployment:
# gcloud firestore fields ttls update expiresAt --collection-group=analysisQuota --enable-ttl

# Optional variable-name mappings (default names are POTHUB_PROVIDER, POTHUB_API_KEY, POTHUB_MODEL, POTHUB_ALLOWED_EMAILS)
# POTHUB_PROVIDER_ENV=MY_PROVIDER_VAR
# POTHUB_API_KEY_ENV=MY_SECRET_VAR
# POTHUB_MODEL_ENV=MY_MODEL_VAR
# POTHUB_ALLOWED_EMAILS_ENV=MY_ALLOWED_USERS_VAR

# Dedicated isolated Docker runner. These are server-only values; never prefix with VITE_.
ENGINE_RUNNER_URL=
ENGINE_RUNNER_TOKEN=

# Per-user Vercel OAuth (tokens are encrypted at rest in Firestore)
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# GitHub repository webhook signature verification for build notifications
GITHUB_WEBHOOK_SECRET=

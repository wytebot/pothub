# Firebase web configuration is embedded in src/firebase.ts. No VITE_FIREBASE_* values are required.
# Optional public VAPID key for remote web push only:
# VITE_POTHUB_WEB_PUSH_VAPID_KEY=

# Never add provider API keys, Firebase service-account JSON, Flutterwave secrets,
# LICENSE_SECRET, access tokens, or any other private credential to this file.


# Publisher index: Firestore TTL is configured on the publisherSites collection using expiresAt.

# Vercel project environment variables read by the functions in /api (server-side only, never VITE_):
# Billing server-side variables (Vercel only; do not prefix with VITE_):
# FLW_SECRET_KEY=FLWSECK_TEST-... or live Secret Key
# FLW_WEBHOOK_HASH=...
# FIREBASE_SERVICE_ACCOUNT=... (Firebase Admin service-account JSON, or base64 JSON)
# APP_ORIGIN=https://pothub-self.vercel.app
# PRO_MONTHLY_AMOUNT=5.99
# PRO_PLUS_MONTHLY_AMOUNT=9.99
# # PREMIUM_CURRENCY=USD
# FLW_CLIENT_ID is not required by Pothub's hosted Flutterwave v3 checkout.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://your-vercel-domain/api/github/oauth/callback   (optional)
# SITE_VERIFY_SECRET=   (optional; falls back to GITHUB_CLIENT_SECRET)
# VERCEL_CLIENT_ID=
# VERCEL_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
# DOCTOR_WEBHOOK_SECRET=

# Optional provider proxy settings (set as Vercel server-side environment variables, never VITE_).
# POTHUB_PROVIDER=openai
# POTHUB_API_KEY=
# POTHUB_MODEL=gpt-4o
# POTHUB_ALLOWED_EMAILS=you@example.com
# Optional: map the above logical settings to your own environment variable names (defaults remain shown above).
# POTHUB_PROVIDER_ENV=MY_PROVIDER_VAR
# POTHUB_API_KEY_ENV=MY_SECRET_VAR
# POTHUB_MODEL_ENV=MY_MODEL_VAR
# POTHUB_ALLOWED_EMAILS_ENV=MY_ALLOWED_USERS_VAR
# Public build-time option: VITE_ALLOW_DEVICE_KEYS=false hides "store a key on this device".

# Software Doctor (Vercel server-side only)
DOCTOR_WEBHOOK_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# GitHub repository webhook signature verification for build notifications
GITHUB_WEBHOOK_SECRET=

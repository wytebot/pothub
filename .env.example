# Required server-side configuration (never expose secrets with VITE_ prefixes)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=replace-with-at-least-32-random-characters
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Flutterwave v4 USD card charges
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
FLW_MODE=sandbox

# Optional server/runtime settings
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_2=gemini-2.5-flash
GEMINI_MODEL_3=gemini-2.5-flash
APP_URL=
APP_ORIGIN=

# Optional remote notification delivery
VERCEL_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional frontend build setting. Not a secret; usually leave blank for same-origin web deployments.
VITE_API_BASE_URL=

# Optional display-only estimate for Nigerian users. Keep updated; checkout still charges USD.
VITE_NGN_PER_USD=

# Optional OpenAI-compatible fallback provider (Groq/OpenRouter/etc.)
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_MAX_PROMPT_CHARS=60000
AI_MAX_OUTPUT_TOKENS=3072

# Optional per-user Vercel OAuth (register this exact callback URL in Vercel)
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_REDIRECT_URI=
VERCEL_OAUTH_SCOPES=
AI_MAX_OPERATION_COST_USD=0.12
GEMINI_INPUT_USD_PER_MILLION=0.3
GEMINI_OUTPUT_USD_PER_MILLION=2.5
AI_FALLBACK_INPUT_USD_PER_MILLION=0.3
AI_FALLBACK_OUTPUT_USD_PER_MILLION=2.5

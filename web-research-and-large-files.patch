+  return links.map((l, i) => ({ l, i, s: scoreLink(l, terms) })).filter((x) => x.s > 0 && !seen.has(normUrl(x.l.url))).sort((a, b) => b.s - a.s || a.i - b.i).slice(0, n).map((x) => x.l);

{
  "name": "pothub-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-next-assets.mjs",
    "dev": "next dev -H 0.0.0.0",
    "dev:api": "node server/dev.js",
    "build": "node scripts/prepare-next-assets.mjs && node scripts/stamp-service-worker.mjs && next build",
    "start": "next start -H 0.0.0.0",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "android:configure": "node scripts/configure-android.mjs",
    "check": "node --check server/app.js && node --check server/lib.js && node scripts/release-audit.mjs && npm test",
    "pricing:check": "node scripts/pricing-check.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.4",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@google/generative-ai": "^0.24.1",
    "@hapi/iron": "^7.0.1",
    "dexie": "^4.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2",
    "@capacitor/share": "^6.0.3",
    "@capgo/capacitor-native-biometric": "^6.0.0",
    "@aparajita/capacitor-secure-storage": "^6.0.0",
    "highlight.js": "^11.11.1",
    "pdfjs-dist": "^4.10.38",
    "next": "^14.2.31"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1"
  }
}

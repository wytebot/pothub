{
  "name": "pothub-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node server/dev.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/dev.js",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "android:configure": "node scripts/configure-android.mjs",
    "check": "node --check server/app.js && node --check server/lib.js && node scripts/release-audit.mjs && npm test",
    "pricing:check": "node scripts/pricing-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "migrate:firestore": "node scripts/migrate-supabase-to-firestore.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.4",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/push-notifications": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2",
    "@google/generative-ai": "^0.24.1",
    "@hapi/iron": "^7.0.1",
    "dexie": "^4.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.5.0",
    "framer-motion": "^11.15.0",
    "helmet": "^8.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.2",
    "@capacitor/share": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}

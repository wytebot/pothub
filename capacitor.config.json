{
  "appId": "app.kithub.ai",
  "appName": "Pothub",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "github.com",
      "api.github.com",
      "vercel.com",
      "api.vercel.com",
      "www.googleapis.com",
      "f4bexperience.flutterwave.com",
      "developersandbox-api.flutterwave.com"
    ]
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#080808"
    },
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#080808",
      "showSpinner": false
    }
  }
}
